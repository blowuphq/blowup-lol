# Local dev Postgres (Docker container started for Phase 1)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blowup
# Local dev Redis (Phase 2 leaderboard projection; Upstash at deploy)
REDIS_URL=redis://localhost:6379

# Stripe (Phase 3). Use a RESTRICTED key (rk_...) scoped to Checkout writes in
# production; the webhook secret comes from `stripe listen` or the dashboard.
# Signature verification itself needs no API key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_placeholder
APP_URL=http://localhost:3000
