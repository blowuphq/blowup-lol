# Local dev Postgres (Docker container started for Phase 1)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blowup
# Local dev Redis (Phase 2 leaderboard projection; Upstash at deploy)
REDIS_URL=redis://localhost:6379

# Dodo Payments (Phase 5). Use a test-mode key for local dev; the webhook
# secret comes from the Dodo Payments dashboard → Webhooks.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_BID_PRODUCT_ID=
APP_URL=http://localhost:3000

# Coming-soon mode (Phase 5.1). Set to "true" on the production domain
# to show a launch page while staging/preview deploys run the full app.
# Omit or set to any other value for the full app experience.
# COMING_SOON_MODE=true
